# ─── Kite Connect API Credentials (REQUIRED) ────────────────────────
# Get these from https://developers.kite.trade
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# ─── Telegram Notifications (Optional) ──────────────────────────────
# Create a bot via @BotFather and get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Database ───────────────────────────────────────────────────────
# Default SQLite (works out of the box)
DATABASE_URL=sqlite:///trades.db
# For Docker: DATABASE_URL=sqlite:////app/data/trades.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/trading_bot

# ─── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
# For Docker: LOG_FILE=/app/logs/trading_bot.log
